CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=
CAPITAL_API_PASSWORD=
CAPITAL_DEMO=true
FINNHUB_API_KEY=
CRON_SECRET=
KURISKO_SCAN_ENABLED=true
KURISKO_SCAN_INTERVAL_MS=60000

# --- Data persistence (planned — Phase 1+; see docs/KURISKO_DATA_PERSISTENCE.md) ---
# Set KURISKO_DATA_ENABLED=false to run in-memory-only mode (legacy).
KURISKO_DATA_ENABLED=true
KURISKO_DATA_DIR=./data
KURISKO_CANDLE_RETENTION_DAYS=45
KURISKO_SNAPSHOT_RETENTION_DAYS=14
KURISKO_ALERT_RETENTION_DAYS=30
KURISKO_BACKFILL_ON_START=true
KURISKO_SNAPSHOT_PERSIST=true
KURISKO_CANDLE_BACKFILL_EVERY_TICK=true
KURISKO_SQLITE_WAL=true

# --- Dux GUS research (CLI; does not affect Kurisko UI) ---
# FUTU_OPEND_HOST=127.0.0.1
# FUTU_OPEND_PORT=11111
# DUX_DATA_DIR=./data/dux
# Live defaults: unarmed dry-run. See docs/dux/PHASE4_LIVE.md
# DUX_LIVE_ARMED=false
# DUX_TRD_ENV=SIMULATE
# DUX_MAX_SHARES=100
# DUX_MAX_NOTIONAL=2000
# DUX_SYMBOL_ALLOWLIST=
# DUX_LIVE_KILL=false
# DUX_BROKER=mock
